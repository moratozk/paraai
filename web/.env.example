# =========================================================================
# Copie este arquivo para ".env" e preencha com os valores do SEU projeto
# Firebase. Onde encontrar: Firebase Console > Configurações do projeto >
# Geral > "Seus apps" > app Web > Configuração do SDK.
#
# O ".env" real está no .gitignore e nunca deve ser commitado.
# =========================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional (Google Analytics do Firebase)
VITE_FIREBASE_MEASUREMENT_ID=
