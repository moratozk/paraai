// =========================================================================
// Regras de segurança do Firestore — ParaAí
// Cada pessoa acessa apenas os próprios dados. Cada totem usa uma conta
// exclusiva do Firebase Authentication e fica vinculado a um estacionamento.
// =========================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDoSistema() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == 'admin';
    }

    function estacionamentoExiste(estId) {
      return exists(/databases/$(database)/documents/estacionamentos/$(estId));
    }

    function donoDoEstacionamento(estId) {
      return signedIn()
        && estacionamentoExiste(estId)
        && get(/databases/$(database)/documents/estacionamentos/$(estId)).data.ownerUid
          == request.auth.uid;
    }

    function totemCadastrado() {
      return signedIn()
        && exists(/databases/$(database)/documents/totems/$(request.auth.uid))
        && get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.ativo
          == true;
    }

    function totemDoEstacionamento(estId) {
      return totemCadastrado()
        && get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.estacionamentoId
          == estId;
    }

    function donoDoVeiculo(placa) {
      return signedIn()
        && exists(/databases/$(database)/documents/veiculos/$(placa))
        && get(/databases/$(database)/documents/veiculos/$(placa)).data.ownerUid
          == request.auth.uid;
    }

    function veiculoSemDono() {
      return !('ownerUid' in resource.data)
        || resource.data.ownerUid == null
        || resource.data.ownerUid == '';
    }

    // Formatos criados pelo painel e pelo totem. Validá-los aqui evita que
    // clientes autenticados deixem documentos que o firmware não consegue
    // interpretar (ou incluam campos inesperados).
    function veiculoInicialDoPainelValido(dados) {
      return dados.keys().hasOnly([
          'ativo', 'vagaAtual', 'horaEntrada', 'saldo', 'estacionamentoId',
          'tarifaHoraEntrada', 'ownerUid', 'ownerNome', 'atualizadoEm'
        ])
        && dados.keys().hasAll([
          'ativo', 'vagaAtual', 'horaEntrada', 'saldo', 'ownerUid',
          'atualizadoEm'
        ])
        && dados.ativo == true
        && dados.vagaAtual == 0
        && dados.horaEntrada == 0
        && dados.saldo is number && dados.saldo >= 0
        // Os dois campos abaixo foram acrescentados depois da primeira
        // versão do painel. Aceitamos a ausência apenas para não interromper
        // uma página antiga que ainda esteja em cache durante a atualização.
        && (!('estacionamentoId' in dados) || dados.estacionamentoId == '')
        && (!('tarifaHoraEntrada' in dados) || dados.tarifaHoraEntrada == 0)
        && dados.ownerUid == request.auth.uid
        // O nome não é mais gravado (todo totem lê o veículo); aceito só para
        // uma página antiga ainda em cache.
        && (!('ownerNome' in dados) || dados.ownerNome is string)
        && dados.atualizadoEm is timestamp;
    }

    function veiculoInicialDoTotemValido(dados) {
      return dados.keys().hasOnly([
          'ativo', 'vagaAtual', 'horaEntrada', 'saldo', 'estacionamentoId',
          'tarifaHoraEntrada', 'cadastradoNoTotem'
        ])
        && dados.keys().hasAll([
          'ativo', 'vagaAtual', 'horaEntrada', 'saldo', 'estacionamentoId',
          'cadastradoNoTotem'
        ])
        && dados.ativo == true
        && dados.vagaAtual == 0
        && dados.horaEntrada == 0
        && dados.saldo is number && dados.saldo >= 0
        && dados.estacionamentoId == ''
        // Também aceita o firmware já gravado antes de tarifaHoraEntrada
        // existir. O próximo firmware passa a criar o campo explicitamente.
        && (!('tarifaHoraEntrada' in dados) || dados.tarifaHoraEntrada == 0)
        && dados.cadastradoNoTotem == true;
    }

    // Horários em segundos gravados pelo totem precisam ser os do momento da
    // gravação. A folga cobre latência e diferença pequena do NTP, sem aceitar
    // estadia retroativa nem saída no futuro (que inflariam a cobrança).
    function horarioAtual(segundos) {
      return segundos is int
        && segundos * 1000 >= request.time.toMillis() - 300000
        && segundos * 1000 <= request.time.toMillis() + 60000;
    }

    // Um totem só pode abrir uma estadia que ainda está fora de qualquer
    // pátio e fechá-la se ela pertence ao próprio estacionamento. Isso mantém
    // a carteira global, mas impede um equipamento de alterar uma estadia
    // operada por outro totem.
    function totemPodeRegistrarEntrada(placa) {
      return totemCadastrado()
        && resource.data.ativo == true
        && resource.data.vagaAtual == 0
        // Saldo negativo é pendência de uma estadia anterior: regularizar
        // antes de entrar. Meio centavo absorve resíduo de ponto flutuante.
        && resource.data.saldo is number
        && resource.data.saldo > -0.005
        && (!('ownerUid' in resource.data)
          || !exists(/databases/$(database)/documents/estadiasApp/$(resource.data.ownerUid))
          || get(/databases/$(database)/documents/estadiasApp/$(resource.data.ownerUid)).data.status
            != 'ativa')
        && (!('estacionamentoId' in resource.data)
          || resource.data.estacionamentoId == '')
        && request.resource.data.vagaAtual is int
        && request.resource.data.vagaAtual > 0
        && request.resource.data.vagaAtual <= 200
        && request.resource.data.vagaAtual <= get(/databases/$(database)/documents/estacionamentos/$(request.resource.data.estacionamentoId)).data.numVagas
        && horarioAtual(request.resource.data.horaEntrada)
        && request.resource.data.estacionamentoId
          == get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.estacionamentoId
        && request.resource.data.tarifaHoraEntrada is number
        && request.resource.data.tarifaHoraEntrada >= 0
        && request.resource.data.tarifaHoraEntrada <= 10000
        && request.resource.data.tarifaHoraEntrada == get(/databases/$(database)/documents/estacionamentos/$(request.resource.data.estacionamentoId)).data.tarifaHora
        && vagaDaEntradaConfere(placa)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vagaAtual', 'horaEntrada', 'estacionamentoId', 'tarifaHoraEntrada'
        ]);
    }

    function vagaDaEntradaConfere(placa) {
      let vaga = getAfter(/databases/$(database)/documents/estacionamentos/$(request.resource.data.estacionamentoId)/vagas/$(string(request.resource.data.vagaAtual))).data;
      return vaga.placa == placa && vaga.ocupada == true && vaga.origemOcupacao == 'registro';
    }

    function totemPodeRegistrarSaida(placa) {
      return totemCadastrado()
        && resource.data.vagaAtual is int
        && resource.data.vagaAtual > 0
        && resource.data.estacionamentoId
          == get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.estacionamentoId
        && resource.data.saldo is number
        && request.resource.data.vagaAtual == 0
        && request.resource.data.horaEntrada == 0
        && request.resource.data.estacionamentoId == ''
        && request.resource.data.saldo is number
        && request.resource.data.saldo <= resource.data.saldo
        && request.resource.data.tarifaHoraEntrada == 0
        // Não aceitar débito isolado. O recibo desta estadia deve nascer
        // junto da saída, e o saldo precisa refletir exatamente sua cobrança.
        && reciboDaSaidaConfere(placa)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vagaAtual', 'horaEntrada', 'estacionamentoId', 'saldo',
          'tarifaHoraEntrada'
        ]);
    }

    function pareamentoValido(dados) {
      return dados.estacionamentoId is string
        && estacionamentoExiste(dados.estacionamentoId)
        && get(/databases/$(database)/documents/estacionamentos/$(dados.estacionamentoId)).data.totemPairingCode
          is string
        && dados.pairingCode
          == get(/databases/$(database)/documents/estacionamentos/$(dados.estacionamentoId)).data.totemPairingCode;
    }

    function perfilDeOperador(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'operador';
    }

    function vinculoInicialDeEstacionamentoValido(uid) {
      return resource.data.role == 'operador'
        && !('estacionamentoId' in resource.data)
        && request.resource.data.role == 'operador'
        && request.resource.data.estacionamentoId is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estacionamentoId'])
        && getAfter(/databases/$(database)/documents/estacionamentos/$(request.resource.data.estacionamentoId)).data.ownerUid
          == uid;
    }

    function catalogoSomenteComCamposPublicos(dados) {
      return dados.keys().hasOnly([
          'nome', 'numVagas', 'tarifaHora', 'tarifaMinuto', 'ativo', 'cep', 'logradouro', 'numero',
          'bairro', 'cidade', 'uf', 'ultimaAtualizacao', 'vagasLivres',
          'vagasEmOperacao', 'modoDisponibilidade', 'vagasLivresMapeadas',
          'ultimaAtualizacaoMapa', 'atualizadoEm'
        ])
        && dados.nome is string
        && dados.numVagas is number && dados.numVagas > 0
        && dados.tarifaHora is number && dados.tarifaHora >= 0
        && (!('tarifaMinuto' in dados)
          || (dados.tarifaMinuto is number && dados.tarifaMinuto >= 0))
        && (!('ativo' in dados) || dados.ativo is bool)
        && dados.cep is string
        && dados.logradouro is string
        && dados.numero is string
        && dados.bairro is string
        && dados.cidade is string
        && dados.uf is string
        && (!('ultimaAtualizacao' in dados)
          || (dados.ultimaAtualizacao is number && dados.ultimaAtualizacao >= 0))
        && (!('vagasLivres' in dados)
          || (dados.vagasLivres is number && dados.vagasLivres >= 0))
        && (!('vagasEmOperacao' in dados)
          || (dados.vagasEmOperacao is number && dados.vagasEmOperacao >= 0))
        && (!('modoDisponibilidade' in dados)
          || dados.modoDisponibilidade == 'mapa')
        && (!('vagasLivresMapeadas' in dados)
          || (dados.vagasLivresMapeadas is number
            && dados.vagasLivresMapeadas >= 0
            && dados.vagasLivresMapeadas <= dados.numVagas))
        && (!('ultimaAtualizacaoMapa' in dados)
          || dados.ultimaAtualizacaoMapa is timestamp)
        && (!('atualizadoEm' in dados) || dados.atualizadoEm is timestamp);
    }

    function reciboDaSaidaConfere(placa) {
      let caminho = /databases/$(database)/documents/historico/$(placa + '_' + string(resource.data.horaEntrada));
      let recibo = getAfter(caminho).data;
      return !exists(caminho)
        && recibo.placa == placa
        && recibo.entrada == resource.data.horaEntrada
        && recibo.estacionamentoId == resource.data.estacionamentoId
        && math.abs(resource.data.saldo - request.resource.data.saldo - recibo.valorCobrado) < 0.000001;
    }

    // O equipamento publica disponibilidade somente no próprio pátio.
    // Não pode criar a vitrine, trocar preço/endereço ou incluir credenciais.
    function disponibilidadeValida(dados) {
      return dados.ultimaAtualizacao is int && dados.ultimaAtualizacao > 0
        && dados.vagasEmOperacao is int
        && dados.vagasEmOperacao >= 1 && dados.vagasEmOperacao <= 200
        && dados.vagasEmOperacao <= dados.numVagas
        && dados.vagasLivres is int
        && dados.vagasLivres >= 0 && dados.vagasLivres <= dados.vagasEmOperacao;
    }

    function dadosVagaValidos(dados) {
      return dados.keys().hasOnly(['ocupada', 'placa', 'origemOcupacao', 'tipo'])
        && dados.origemOcupacao == 'registro'
        && dados.ocupada is bool && dados.placa is string
        && (dados.placa == '' || dados.placa.matches('^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$'))
        && dados.ocupada == (dados.placa != '')
        // Classificação gravada pela administração em vagas antigas.
        && (!('tipo' in dados) || dados.tipo in ['comum', 'pcd', 'idoso', 'gestante']);
    }

    function transicaoVagaValida(estId, numero) {
      let caminho = /databases/$(database)/documents/estacionamentos/$(estId)/vagas/$(numero);
      let anterior = exists(caminho) ? get(caminho).data.get('placa', '') : '';
      let nova = request.resource.data.placa;
      return numero.matches('^([1-9]|[1-9][0-9]|1[0-9]{2}|200)$')
        && ((nova != '' && anterior == ''
          && get(/databases/$(database)/documents/veiculos/$(nova)).data.vagaAtual == 0
          && getAfter(/databases/$(database)/documents/veiculos/$(nova)).data.vagaAtual == int(numero)
          && getAfter(/databases/$(database)/documents/veiculos/$(nova)).data.estacionamentoId == estId)
        || (nova == '' && anterior != ''
          && get(/databases/$(database)/documents/veiculos/$(anterior)).data.vagaAtual == int(numero)
          && get(/databases/$(database)/documents/veiculos/$(anterior)).data.estacionamentoId == estId
          && getAfter(/databases/$(database)/documents/veiculos/$(anterior)).data.vagaAtual == 0));
    }

    function historicoValido(dados) {
      return dados.keys().hasOnly(['placa', 'vaga', 'entrada', 'saida',
          'duracaoMinutos', 'valorCobrado', 'valorPendente', 'tarifaHora',
          'estacionamentoId'])
        && dados.placa is string
        && dados.placa.matches('^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$')
        && dados.vaga is int && dados.vaga >= 1 && dados.vaga <= 200
        && dados.entrada is int && dados.entrada > 0
        && dados.saida is int && dados.saida >= dados.entrada
        && horarioAtual(dados.saida)
        && dados.duracaoMinutos is int && dados.duracaoMinutos >= 0
        && dados.valorCobrado is number && dados.valorCobrado >= 0
        && dados.valorPendente is number && dados.valorPendente >= 0
        && dados.tarifaHora is number && dados.tarifaHora >= 0 && dados.tarifaHora <= 10000;
    }

    function historicoCorrespondeAEstadia(dados, registro) {
      let antes = get(/databases/$(database)/documents/veiculos/$(dados.placa)).data;
      let depois = getAfter(/databases/$(database)/documents/veiculos/$(dados.placa)).data;
      let vagaDepois = getAfter(/databases/$(database)/documents/estacionamentos/$(dados.estacionamentoId)/vagas/$(string(dados.vaga))).data;
      return registro == dados.placa + '_' + string(dados.entrada)
        && antes.vagaAtual == dados.vaga
        && antes.horaEntrada == dados.entrada
        && antes.estacionamentoId == dados.estacionamentoId
        && antes.tarifaHoraEntrada == dados.tarifaHora
        && depois.vagaAtual == 0 && depois.estacionamentoId == ''
        && vagaDepois.placa == '' && vagaDepois.ocupada == false
        && vagaDepois.origemOcupacao == 'registro'
        && dados.duracaoMinutos == int((dados.saida - dados.entrada) / 60)
        && math.abs(dados.valorCobrado - math.round((dados.saida - dados.entrada) / 3600.0 * dados.tarifaHora * 100) / 100.0) < 0.000001
        && pendenteConfere(dados, depois.saldo);
    }

    // Parte desta cobrança que o saldo não cobriu (0 quando cobriu tudo).
    // Dívida anterior não entra: no máximo o próprio valor da estadia.
    function pendenteConfere(dados, saldoDepois) {
      return (saldoDepois >= 0 && dados.valorPendente < 0.000001)
        || (saldoDepois < 0 && saldoDepois + dados.valorCobrado <= 0
          && math.abs(dados.valorPendente - dados.valorCobrado) < 0.000001)
        || (saldoDepois < 0 && saldoDepois + dados.valorCobrado > 0
          && math.abs(dados.valorPendente + saldoDepois) < 0.000001);
    }

    function placaDeMotoristaValida() {
      return resource.data.role == 'motorista'
        && request.resource.data.placa is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['placa']);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
      // O cadastro público cria somente motoristas. Contas administrativas
      // são promovidas fora do cliente, e operadores antigos são preservados.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'motorista';
      allow update: if signedIn() && request.auth.uid == uid
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'telefone', 'photoURL'
          ])
          || placaDeMotoristaValida()
          || vinculoInicialDeEstacionamentoValido(uid)
        );
    }

    match /estacionamentos/{estId} {
      // Motoristas leem a projeção segura em catalogoEstacionamentos.
      allow read: if adminDoSistema()
        || donoDoEstacionamento(estId)
        || totemDoEstacionamento(estId);
      allow create: if adminDoSistema()
        || (signedIn()
          && perfilDeOperador(request.auth.uid)
          && request.resource.data.ownerUid == request.auth.uid);
      allow update: if adminDoSistema()
        || donoDoEstacionamento(estId)
        || (totemDoEstacionamento(estId)
          && disponibilidadeValida(request.resource.data)
          && request.resource.data.modoTotem == 'atendimento'
          && !('vagasSuportadasTotem' in request.resource.data)
          && request.resource.data.tarifaAplicadaTotem is number
          && request.resource.data.tarifaAplicadaTotem >= 0
          && request.resource.data.tarifaAplicadaTotem <= 10000
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ultimaAtualizacao',
            'vagasLivres',
            'vagasSuportadasTotem',
            'modoTotem',
            'vagasEmOperacao',
            'tarifaAplicadaTotem'
          ]));
      allow delete: if adminDoSistema() || donoDoEstacionamento(estId);

      match /vagas/{vaga} {
        allow read: if adminDoSistema()
          || donoDoEstacionamento(estId)
          || totemDoEstacionamento(estId);
        allow create: if totemDoEstacionamento(estId)
          && dadosVagaValidos(request.resource.data)
          && transicaoVagaValida(estId, vaga);
        allow update: if totemDoEstacionamento(estId)
          && dadosVagaValidos(request.resource.data)
          && transicaoVagaValida(estId, vaga)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ocupada', 'placa', 'origemOcupacao', 'leituraValida'
          ]);
        // Apagar uma vaga ocupada deixaria a estadia sem saída possível.
        allow delete: if (adminDoSistema() || donoDoEstacionamento(estId))
          && resource.data.get('placa', '') == '';
      }
    }

    match /catalogoEstacionamentos/{estId} {
      allow read: if signedIn();
      allow create: if catalogoSomenteComCamposPublicos(request.resource.data)
        && (adminDoSistema()
          || (signedIn()
            && getAfter(/databases/$(database)/documents/estacionamentos/$(estId)).data.ownerUid
              == request.auth.uid));
      allow update: if signedIn()
        && catalogoSomenteComCamposPublicos(request.resource.data)
        && (adminDoSistema()
          || donoDoEstacionamento(estId)
          || (totemDoEstacionamento(estId)
            && disponibilidadeValida(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'ultimaAtualizacao', 'vagasLivres', 'vagasEmOperacao'
            ])));
      allow delete: if adminDoSistema() || donoDoEstacionamento(estId);

      // Projeção do mapa para motoristas: expõe somente livre/ocupada, nunca
      // placa, proprietário ou credencial operacional.
      match /vagas/{vaga} {
        allow read: if signedIn();
        allow create, update: if (adminDoSistema() || donoDoEstacionamento(estId))
          && vagaPublicaValida(request.resource.data);
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reservada'])
          && (
            (request.resource.data.reservada == true
              && resource.data.ocupada == false
              && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.ownerUid
                == request.auth.uid
              && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.estacionamentoId
                == estId
              && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.vagaId
                == vaga
              && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.status
                == 'ativa')
            || (request.resource.data.reservada == false
              && get(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.ownerUid
                == request.auth.uid
              && get(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.estacionamentoId
                == estId
              && get(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.vagaId
                == vaga
              && get(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.status
                == 'ativa'
              && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.status
                == 'finalizada')
          );
        allow delete: if adminDoSistema() || donoDoEstacionamento(estId);
      }
    }

    match /estadiasApp/{uid} {
      // A central administrativa cruza reservas ativas com o mapa de vagas.
      // Motoristas continuam restritos ao próprio documento.
      allow read: if adminDoSistema()
        || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && estadiaAppNovaValida(uid, request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && (
          (resource.data.status == 'finalizada'
            && estadiaAppNovaValida(uid, request.resource.data))
          || (resource.data.ownerUid == uid
            && request.resource.data.ownerUid == uid
            && resource.data.status == 'ativa'
            && request.resource.data.status == 'finalizada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'fim', 'minutosCobrados', 'valorCobrado',
              'valorDebitadoNaSaida', 'finalizadoEm'
            ])
            && request.resource.data.fim is int
            && request.resource.data.minutosCobrados is int
            && request.resource.data.minutosCobrados >= 1
            && request.resource.data.valorCobrado is number
            && request.resource.data.valorCobrado >= resource.data.tarifaMinuto
            && request.resource.data.valorDebitadoNaSaida is number
            && request.resource.data.valorDebitadoNaSaida >= 0
            && request.resource.data.finalizadoEm is timestamp)
        );
      allow delete: if false;
    }

    function vagaPublicaValida(dados) {
      return dados.keys().hasOnly(['ocupada', 'reservada', 'tipo'])
        && dados.keys().hasAll(['ocupada'])
        && dados.ocupada is bool
        && (!('reservada' in dados) || dados.reservada is bool)
        && (!('tipo' in dados)
          || (dados.tipo is string
            && dados.tipo in ['comum', 'pcd', 'idoso', 'gestante']));
    }

    function estadiaAppNovaValida(uid, dados) {
      return dados.keys().hasOnly([
          'ownerUid', 'placa', 'estacionamentoId', 'vaga', 'vagaId',
          'historicoId', 'inicio', 'tarifaMinuto', 'modoPagamento',
          'valorAntecipado', 'status', 'criadoEm'
        ])
        && dados.keys().hasAll([
          'ownerUid', 'placa', 'estacionamentoId', 'vaga', 'vagaId',
          'historicoId', 'inicio', 'tarifaMinuto', 'modoPagamento',
          'valorAntecipado', 'status', 'criadoEm'
        ])
        && dados.ownerUid == uid
        && dados.placa is string
        && get(/databases/$(database)/documents/users/$(uid)).data.placa
          == dados.placa
        && get(/databases/$(database)/documents/veiculos/$(dados.placa)).data.ownerUid
          == uid
        && get(/databases/$(database)/documents/veiculos/$(dados.placa)).data.vagaAtual
          == 0
        && dados.estacionamentoId is string
        && dados.vaga is int && dados.vaga > 0 && dados.vaga <= 200
        && dados.vagaId is string
        && dados.historicoId is string
        && dados.inicio is int && dados.inicio > 0
        && dados.tarifaMinuto is number && dados.tarifaMinuto > 0
        && ((('tarifaMinuto' in get(/databases/$(database)/documents/catalogoEstacionamentos/$(dados.estacionamentoId)).data)
              && dados.tarifaMinuto
                == get(/databases/$(database)/documents/catalogoEstacionamentos/$(dados.estacionamentoId)).data.tarifaMinuto)
          || (!('tarifaMinuto' in get(/databases/$(database)/documents/catalogoEstacionamentos/$(dados.estacionamentoId)).data)
              && dados.tarifaMinuto == 0.22))
        && dados.modoPagamento in ['agora', 'depois']
        && ((dados.modoPagamento == 'agora' && dados.valorAntecipado == dados.tarifaMinuto)
          || (dados.modoPagamento == 'depois' && dados.valorAntecipado == 0))
        && dados.status == 'ativa'
        && dados.criadoEm is timestamp
        && (!('ativo' in get(/databases/$(database)/documents/catalogoEstacionamentos/$(dados.estacionamentoId)).data)
          || get(/databases/$(database)/documents/catalogoEstacionamentos/$(dados.estacionamentoId)).data.ativo
            == true)
        && get(/databases/$(database)/documents/catalogoEstacionamentos/$(dados.estacionamentoId)/vagas/$(dados.vagaId)).data.ocupada
          == false
        && getAfter(/databases/$(database)/documents/catalogoEstacionamentos/$(dados.estacionamentoId)/vagas/$(dados.vagaId)).data.reservada
          == true
        && getAfter(/databases/$(database)/documents/historico/$(dados.historicoId)).data.ownerUid
          == uid
        && getAfter(/databases/$(database)/documents/historico/$(dados.historicoId)).data.status
          == 'ativa';
    }

    function historicoAppNovoValido(uid, registro, dados) {
      return dados.keys().hasOnly([
          'origem', 'ownerUid', 'placa', 'estacionamentoId', 'vaga',
          'entrada', 'saida', 'duracaoMinutos', 'tarifaMinuto',
          'modoPagamento', 'valorAntecipado', 'valorCobrado', 'status',
          'criadoEm'
        ])
        && dados.keys().hasAll([
          'origem', 'ownerUid', 'placa', 'estacionamentoId', 'vaga',
          'entrada', 'saida', 'duracaoMinutos', 'tarifaMinuto',
          'modoPagamento', 'valorAntecipado', 'valorCobrado', 'status',
          'criadoEm'
        ])
        && dados.origem == 'aplicativo'
        && dados.ownerUid == uid
        && dados.placa is string
        && get(/databases/$(database)/documents/users/$(uid)).data.placa
          == dados.placa
        && get(/databases/$(database)/documents/veiculos/$(dados.placa)).data.ownerUid
          == uid
        && dados.estacionamentoId is string
        && dados.vaga is int && dados.vaga > 0 && dados.vaga <= 200
        && dados.entrada is int && dados.entrada > 0
        && dados.saida == 0
        && dados.duracaoMinutos == 0
        && dados.tarifaMinuto is number && dados.tarifaMinuto > 0
        && dados.tarifaMinuto
          == getAfter(/databases/$(database)/documents/estadiasApp/$(uid)).data.tarifaMinuto
        && dados.modoPagamento in ['agora', 'depois']
        && ((dados.modoPagamento == 'agora' && dados.valorAntecipado == dados.tarifaMinuto)
          || (dados.modoPagamento == 'depois' && dados.valorAntecipado == 0))
        && dados.valorCobrado == dados.valorAntecipado
        && dados.status == 'ativa'
        && dados.criadoEm is timestamp
        && getAfter(/databases/$(database)/documents/estadiasApp/$(uid)).data.historicoId
          == registro
        && getAfter(/databases/$(database)/documents/estadiasApp/$(uid)).data.placa
          == dados.placa
        && getAfter(/databases/$(database)/documents/estadiasApp/$(uid)).data.estacionamentoId
          == dados.estacionamentoId
        && getAfter(/databases/$(database)/documents/estadiasApp/$(uid)).data.vaga
          == dados.vaga
        && getAfter(/databases/$(database)/documents/estadiasApp/$(uid)).data.status
          == 'ativa';
    }

    match /totems/{totemUid} {
      allow read: if adminDoSistema()
        || (signedIn()
          && (request.auth.uid == totemUid
            || donoDoEstacionamento(resource.data.estacionamentoId)));
      allow create: if adminDoSistema()
        || (signedIn()
          && ((request.auth.uid == totemUid
              && pareamentoValido(request.resource.data))
            || donoDoEstacionamento(request.resource.data.estacionamentoId)));
      allow update: if adminDoSistema()
        || (signedIn()
          && donoDoEstacionamento(resource.data.estacionamentoId)
          && request.resource.data.estacionamentoId
            == resource.data.estacionamentoId);
      allow delete: if adminDoSistema()
        || (signedIn() && donoDoEstacionamento(resource.data.estacionamentoId));
    }

    match /veiculos/{placa} {
      allow read: if totemCadastrado()
        // O painel consulta primeiro para saber se deve criar ou reivindicar.
        // Sem esta exceção, a leitura de uma placa inédita é recusada antes
        // de a regra de create poder ser avaliada.
        || (signedIn()
          && !exists(/databases/$(database)/documents/veiculos/$(placa)))
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && veiculoSemDono());
      allow create: if (totemCadastrado()
          && veiculoInicialDoTotemValido(request.resource.data))
        || (signedIn()
          && veiculoInicialDoPainelValido(request.resource.data));
      allow update: if totemPodeRegistrarEntrada(placa)
        || totemPodeRegistrarSaida(placa)
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerNome', 'saldo', 'atualizadoEm'
          ]))
        || (signedIn()
          && veiculoSemDono()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerUid', 'ownerNome', 'atualizadoEm'
          ]));
      allow delete: if false;
    }

    match /historico/{registro} {
      allow read: if adminDoSistema()
        || donoDoEstacionamento(resource.data.estacionamentoId)
        || donoDoVeiculo(resource.data.placa);
      allow create: if (totemCadastrado()
          && historicoValido(request.resource.data)
          && historicoCorrespondeAEstadia(request.resource.data, registro)
          && request.resource.data.estacionamentoId
            == get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.estacionamentoId)
        || (signedIn()
          && historicoAppNovoValido(
            request.auth.uid,
            registro,
            request.resource.data
          ));
      allow update: if signedIn()
        && resource.data.origem == 'aplicativo'
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'ativa'
        && request.resource.data.status == 'finalizada'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'saida', 'duracaoMinutos', 'valorCobrado',
          'valorDebitadoNaSaida', 'finalizadoEm'
        ])
        && request.resource.data.saida is int
        && request.resource.data.duracaoMinutos is int
        && request.resource.data.duracaoMinutos >= 1
        && request.resource.data.valorCobrado is number
        && request.resource.data.valorCobrado >= resource.data.tarifaMinuto
        && request.resource.data.valorDebitadoNaSaida is number
        && request.resource.data.valorDebitadoNaSaida >= 0
        && request.resource.data.finalizadoEm is timestamp
        && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.historicoId
          == registro
        && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.status
          == 'finalizada'
        && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.fim
          == request.resource.data.saida
        && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.minutosCobrados
          == request.resource.data.duracaoMinutos
        && getAfter(/databases/$(database)/documents/estadiasApp/$(request.auth.uid)).data.valorCobrado
          == request.resource.data.valorCobrado;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
