// =========================================================================
// Regras de segurança do Firestore — ParaAí
// Cada pessoa acessa apenas os próprios dados. Cada totem usa uma conta
// exclusiva do Firebase Authentication e fica vinculado a um estacionamento.
// =========================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function estacionamentoExiste(estId) {
      return exists(/databases/$(database)/documents/estacionamentos/$(estId));
    }

    function donoDoEstacionamento(estId) {
      return signedIn()
        && estacionamentoExiste(estId)
        && get(/databases/$(database)/documents/estacionamentos/$(estId)).data.ownerUid
          == request.auth.uid;
    }

    function totemCadastrado() {
      return signedIn()
        && exists(/databases/$(database)/documents/totems/$(request.auth.uid))
        && get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.ativo
          == true;
    }

    function totemDoEstacionamento(estId) {
      return totemCadastrado()
        && get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.estacionamentoId
          == estId;
    }

    function donoDoVeiculo(placa) {
      return signedIn()
        && exists(/databases/$(database)/documents/veiculos/$(placa))
        && get(/databases/$(database)/documents/veiculos/$(placa)).data.ownerUid
          == request.auth.uid;
    }

    function veiculoSemDono() {
      return !('ownerUid' in resource.data)
        || resource.data.ownerUid == null
        || resource.data.ownerUid == '';
    }

    // Formatos criados pelo painel e pelo totem. Validá-los aqui evita que
    // clientes autenticados deixem documentos que o firmware não consegue
    // interpretar (ou incluam campos inesperados).
    function veiculoInicialDoPainelValido(dados) {
      return dados.keys().hasOnly([
          'ativo', 'vagaAtual', 'horaEntrada', 'saldo', 'estacionamentoId',
          'tarifaHoraEntrada', 'ownerUid', 'ownerNome', 'atualizadoEm'
        ])
        && dados.keys().hasAll([
          'ativo', 'vagaAtual', 'horaEntrada', 'saldo', 'ownerUid',
          'ownerNome', 'atualizadoEm'
        ])
        && dados.ativo == true
        && dados.vagaAtual == 0
        && dados.horaEntrada == 0
        && dados.saldo is number && dados.saldo >= 0
        // Os dois campos abaixo foram acrescentados depois da primeira
        // versão do painel. Aceitamos a ausência apenas para não interromper
        // uma página antiga que ainda esteja em cache durante a atualização.
        && (!('estacionamentoId' in dados) || dados.estacionamentoId == '')
        && (!('tarifaHoraEntrada' in dados) || dados.tarifaHoraEntrada == 0)
        && dados.ownerUid == request.auth.uid
        && dados.ownerNome is string
        && dados.atualizadoEm is timestamp;
    }

    function veiculoInicialDoTotemValido(dados) {
      return dados.keys().hasOnly([
          'ativo', 'vagaAtual', 'horaEntrada', 'saldo', 'estacionamentoId',
          'tarifaHoraEntrada', 'cadastradoNoTotem'
        ])
        && dados.keys().hasAll([
          'ativo', 'vagaAtual', 'horaEntrada', 'saldo', 'estacionamentoId',
          'cadastradoNoTotem'
        ])
        && dados.ativo == true
        && dados.vagaAtual == 0
        && dados.horaEntrada == 0
        && dados.saldo is number && dados.saldo >= 0
        && dados.estacionamentoId == ''
        // Também aceita o firmware já gravado antes de tarifaHoraEntrada
        // existir. O próximo firmware passa a criar o campo explicitamente.
        && (!('tarifaHoraEntrada' in dados) || dados.tarifaHoraEntrada == 0)
        && dados.cadastradoNoTotem == true;
    }

    // Um totem só pode abrir uma estadia que ainda está fora de qualquer
    // pátio e fechá-la se ela pertence ao próprio estacionamento. Isso mantém
    // a carteira global, mas impede um equipamento de alterar uma estadia
    // operada por outro totem.
    function totemPodeRegistrarEntrada() {
      return totemCadastrado()
        && resource.data.ativo == true
        && resource.data.vagaAtual == 0
        && (!('estacionamentoId' in resource.data)
          || resource.data.estacionamentoId == '')
        && request.resource.data.vagaAtual is int
        && request.resource.data.vagaAtual > 0
        && request.resource.data.vagaAtual <= 4
        && request.resource.data.vagaAtual <= get(/databases/$(database)/documents/estacionamentos/$(request.resource.data.estacionamentoId)).data.numVagas
        && request.resource.data.horaEntrada is int
        && request.resource.data.horaEntrada > 0
        && request.resource.data.estacionamentoId
          == get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.estacionamentoId
        && request.resource.data.tarifaHoraEntrada is number
        && request.resource.data.tarifaHoraEntrada >= 0
        && request.resource.data.tarifaHoraEntrada <= 10000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vagaAtual', 'horaEntrada', 'estacionamentoId', 'tarifaHoraEntrada'
        ]);
    }

    function totemPodeRegistrarSaida(placa) {
      return totemCadastrado()
        && resource.data.vagaAtual is int
        && resource.data.vagaAtual > 0
        && resource.data.estacionamentoId
          == get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.estacionamentoId
        && resource.data.saldo is number
        && request.resource.data.vagaAtual == 0
        && request.resource.data.horaEntrada == 0
        && request.resource.data.estacionamentoId == ''
        && request.resource.data.saldo is number
        && request.resource.data.saldo <= resource.data.saldo
        && request.resource.data.tarifaHoraEntrada == 0
        // Não aceitar débito isolado. O recibo desta estadia deve nascer
        // junto da saída, e o saldo precisa refletir exatamente sua cobrança.
        && reciboDaSaidaConfere(placa)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vagaAtual', 'horaEntrada', 'estacionamentoId', 'saldo',
          'tarifaHoraEntrada'
        ]);
    }

    function pareamentoValido(dados) {
      return dados.estacionamentoId is string
        && estacionamentoExiste(dados.estacionamentoId)
        && get(/databases/$(database)/documents/estacionamentos/$(dados.estacionamentoId)).data.totemPairingCode
          is string
        && dados.pairingCode
          == get(/databases/$(database)/documents/estacionamentos/$(dados.estacionamentoId)).data.totemPairingCode;
    }

    function perfilDeOperador(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'operador';
    }

    function vinculoInicialDeEstacionamentoValido(uid) {
      return resource.data.role == 'operador'
        && !('estacionamentoId' in resource.data)
        && request.resource.data.role == 'operador'
        && request.resource.data.estacionamentoId is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estacionamentoId'])
        && getAfter(/databases/$(database)/documents/estacionamentos/$(request.resource.data.estacionamentoId)).data.ownerUid
          == uid;
    }

    function catalogoSomenteComCamposPublicos(dados) {
      return dados.keys().hasOnly([
          'nome', 'numVagas', 'tarifaHora', 'cep', 'logradouro', 'numero',
          'bairro', 'cidade', 'uf', 'ultimaAtualizacao', 'vagasLivres',
          'vagasEmOperacao', 'atualizadoEm'
        ])
        && dados.nome is string
        && dados.numVagas is number && dados.numVagas > 0
        && dados.tarifaHora is number && dados.tarifaHora >= 0
        && dados.cep is string
        && dados.logradouro is string
        && dados.numero is string
        && dados.bairro is string
        && dados.cidade is string
        && dados.uf is string
        && (!('ultimaAtualizacao' in dados)
          || (dados.ultimaAtualizacao is number && dados.ultimaAtualizacao >= 0))
        && (!('vagasLivres' in dados)
          || (dados.vagasLivres is number && dados.vagasLivres >= 0))
        && (!('vagasEmOperacao' in dados)
          || (dados.vagasEmOperacao is number && dados.vagasEmOperacao >= 0))
        && (!('atualizadoEm' in dados) || dados.atualizadoEm is timestamp);
    }

    function reciboDaSaidaConfere(placa) {
      let caminho = /databases/$(database)/documents/historico/$(placa + '_' + string(resource.data.horaEntrada));
      let recibo = getAfter(caminho).data;
      return !exists(caminho)
        && recibo.placa == placa
        && recibo.entrada == resource.data.horaEntrada
        && recibo.estacionamentoId == resource.data.estacionamentoId
        && math.abs(resource.data.saldo - request.resource.data.saldo - recibo.valorCobrado) < 0.000001;
    }

    // O equipamento publica disponibilidade somente no próprio pátio.
    // Não pode criar a vitrine, trocar preço/endereço ou incluir credenciais.
    function disponibilidadeValida(dados) {
      return dados.ultimaAtualizacao is int && dados.ultimaAtualizacao > 0
        && dados.vagasEmOperacao is int
        && dados.vagasEmOperacao >= 1 && dados.vagasEmOperacao <= 4
        && dados.vagasEmOperacao <= dados.numVagas
        && dados.vagasLivres is int
        && dados.vagasLivres >= 0 && dados.vagasLivres <= dados.vagasEmOperacao;
    }

    function dadosVagaValidos(dados) {
      return (!('ocupada' in dados) || dados.ocupada is bool)
        && (!('leituraValida' in dados) || dados.leituraValida is bool)
        && (!('placa' in dados) || (dados.placa is string
          && (dados.placa == '' || dados.placa.matches('^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$'))));
    }

    function historicoValido(dados) {
      return dados.keys().hasOnly(['placa', 'vaga', 'entrada', 'saida',
          'duracaoMinutos', 'valorCobrado', 'tarifaHora', 'estacionamentoId'])
        && dados.placa is string
        && dados.placa.matches('^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$')
        && dados.vaga is int && dados.vaga >= 1 && dados.vaga <= 4
        && dados.entrada is int && dados.entrada > 0
        && dados.saida is int && dados.saida >= dados.entrada
        && dados.duracaoMinutos is int && dados.duracaoMinutos >= 0
        && dados.valorCobrado is number && dados.valorCobrado >= 0
        && dados.tarifaHora is number && dados.tarifaHora >= 0 && dados.tarifaHora <= 10000;
    }

    function historicoCorrespondeAEstadia(dados, registro) {
      let antes = get(/databases/$(database)/documents/veiculos/$(dados.placa)).data;
      let depois = getAfter(/databases/$(database)/documents/veiculos/$(dados.placa)).data;
      let vagaDepois = getAfter(/databases/$(database)/documents/estacionamentos/$(dados.estacionamentoId)/vagas/$(string(dados.vaga))).data;
      return registro == dados.placa + '_' + string(dados.entrada)
        && antes.vagaAtual == dados.vaga
        && antes.horaEntrada == dados.entrada
        && antes.estacionamentoId == dados.estacionamentoId
        && antes.tarifaHoraEntrada == dados.tarifaHora
        && depois.vagaAtual == 0 && depois.estacionamentoId == ''
        && vagaDepois.placa == ''
        && dados.duracaoMinutos == int((dados.saida - dados.entrada) / 60)
        && math.abs(dados.valorCobrado - math.round((dados.saida - dados.entrada) / 3600.0 * dados.tarifaHora * 100) / 100.0) < 0.000001;
    }

    function placaDeMotoristaValida() {
      return resource.data.role == 'motorista'
        && request.resource.data.placa is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['placa']);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
      // O papel é escolhido apenas na criação da conta. Isso impede que uma
      // conta de motorista seja convertida pelo cliente em conta de operador.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['motorista', 'operador'];
      allow update: if signedIn() && request.auth.uid == uid
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'telefone', 'photoURL'
          ])
          || placaDeMotoristaValida()
          || vinculoInicialDeEstacionamentoValido(uid)
        );
    }

    match /estacionamentos/{estId} {
      // Motoristas leem a projeção segura em catalogoEstacionamentos.
      allow read: if donoDoEstacionamento(estId)
        || totemDoEstacionamento(estId);
      allow create: if signedIn()
        && perfilDeOperador(request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if donoDoEstacionamento(estId)
        || (totemDoEstacionamento(estId)
          && disponibilidadeValida(request.resource.data)
          && request.resource.data.vagasSuportadasTotem == 4
          && request.resource.data.tarifaAplicadaTotem is number
          && request.resource.data.tarifaAplicadaTotem >= 0
          && request.resource.data.tarifaAplicadaTotem <= 10000
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ultimaAtualizacao',
            'vagasLivres',
            'vagasSuportadasTotem',
            'vagasEmOperacao',
            'tarifaAplicadaTotem'
          ]));
      allow delete: if donoDoEstacionamento(estId);

      match /vagas/{vaga} {
        allow read: if donoDoEstacionamento(estId)
          || totemDoEstacionamento(estId);
        allow create: if totemDoEstacionamento(estId)
          && vaga.matches('^[1-4]$')
          && dadosVagaValidos(request.resource.data)
          && request.resource.data.keys().hasOnly(['ocupada', 'placa', 'leituraValida']);
        allow update: if totemDoEstacionamento(estId)
          && vaga.matches('^[1-4]$')
          && dadosVagaValidos(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ocupada', 'placa', 'leituraValida'
          ]);
        allow delete: if donoDoEstacionamento(estId);
      }
    }

    match /catalogoEstacionamentos/{estId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && catalogoSomenteComCamposPublicos(request.resource.data)
        && getAfter(/databases/$(database)/documents/estacionamentos/$(estId)).data.ownerUid
          == request.auth.uid;
      allow update: if signedIn()
        && catalogoSomenteComCamposPublicos(request.resource.data)
        && (donoDoEstacionamento(estId)
          || (totemDoEstacionamento(estId)
            && disponibilidadeValida(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'ultimaAtualizacao', 'vagasLivres', 'vagasEmOperacao'
            ])));
      allow delete: if donoDoEstacionamento(estId);
    }

    match /totems/{totemUid} {
      allow read: if signedIn()
        && (request.auth.uid == totemUid
          || donoDoEstacionamento(resource.data.estacionamentoId));
      allow create: if signedIn()
        && ((request.auth.uid == totemUid
            && pareamentoValido(request.resource.data))
          || donoDoEstacionamento(request.resource.data.estacionamentoId));
      allow update: if signedIn()
        && donoDoEstacionamento(resource.data.estacionamentoId)
        && request.resource.data.estacionamentoId
          == resource.data.estacionamentoId;
      allow delete: if signedIn()
        && donoDoEstacionamento(resource.data.estacionamentoId);
    }

    match /veiculos/{placa} {
      allow read: if totemCadastrado()
        // O painel consulta primeiro para saber se deve criar ou reivindicar.
        // Sem esta exceção, a leitura de uma placa inédita é recusada antes
        // de a regra de create poder ser avaliada.
        || (signedIn()
          && !exists(/databases/$(database)/documents/veiculos/$(placa)))
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && veiculoSemDono());
      allow create: if (totemCadastrado()
          && veiculoInicialDoTotemValido(request.resource.data))
        || (signedIn()
          && veiculoInicialDoPainelValido(request.resource.data));
      allow update: if totemPodeRegistrarEntrada()
        || totemPodeRegistrarSaida(placa)
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerNome', 'saldo', 'atualizadoEm'
          ]))
        || (signedIn()
          && veiculoSemDono()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerUid', 'ownerNome', 'atualizadoEm'
          ]));
      allow delete: if false;
    }

    match /historico/{registro} {
      allow read: if donoDoEstacionamento(resource.data.estacionamentoId)
        || donoDoVeiculo(resource.data.placa);
      allow create: if totemCadastrado()
        && historicoValido(request.resource.data)
        && historicoCorrespondeAEstadia(request.resource.data, registro)
        && request.resource.data.estacionamentoId
          == get(/databases/$(database)/documents/totems/$(request.auth.uid)).data.estacionamentoId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
